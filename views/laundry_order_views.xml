<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_laundry_order_list" model="ir.ui.view">
        <field name="name">laundry.order.list</field>
        <field name="model">laundry.order</field>
        <field name="arch" type="xml">
            <list string="Pesanan Laundry">
                <field name="name"/>
                <field name="partner_id"/>
                <field name="service_type"/>
                <field name="weight"/>
                <field name="total_amount"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <record id="view_laundry_order_form" model="ir.ui.view">
        <field name="name">laundry.order.form</field>
        <field name="model">laundry.order</field>
        <field name="arch" type="xml">
            <form string="Pesanan Laundry">
                <header>
                    <field name="state" widget="statusbar"
                           statusbar_visible="received,washing,ironing,ready,completed"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="partner_id"/>
                            <field name="service_type"/>
                            <field name="weight"/>
                            <field name="price_per_kg"/>
                        </group>
                        <group>
                            <field name="total_amount"/>
                            <field name="currency_id" invisible="1"/>
                            <field name="invoice_id"/>
                        </group>
                    </group>
                    <group>
                        <field name="notes"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_laundry_order" model="ir.actions.act_window">
        <field name="name">Pesanan Laundry</field>
        <field name="res_model">laundry.order</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_laundry_root"
              name="LaundryFlow"
              sequence="10"/>

    <menuitem id="menu_laundry_orders"
              name="Pesanan Laundry"
              parent="menu_laundry_root"
              action="action_laundry_order"
              sequence="10"/>
</odoo>
