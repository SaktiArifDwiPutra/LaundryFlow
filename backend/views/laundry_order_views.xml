<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_laundry_order_list" model="ir.ui.view">
        <field name="name">laundry.order.list</field>
        <field name="model">laundry.order</field>
        <field name="arch" type="xml">
            <list string="Pesanan Laundry">
                <field name="name"/>
                <field name="order_date"/>
                <field name="partner_id"/>
                <field name="service_speed"/>
                <field name="service_speed_fee" optional="show"/>
                <field name="delivery_type" optional="show"/>
                <field name="weight"/>
                <field name="total_amount"/>
                <field name="user_id" widget="many2one_avatar_user"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <record id="view_laundry_order_form" model="ir.ui.view">
        <field name="name">laundry.order.form</field>
        <field name="model">laundry.order</field>
        <field name="arch" type="xml">
            <form string="Pesanan Laundry">
                <header>
                    <button name="action_washing" string="Mulai Cuci" type="object" class="oe_highlight"
                            invisible="state != 'received'"/>
                    <button name="action_drying" string="Mulai Keringkan" type="object" class="oe_highlight"
                            invisible="state != 'washing'"/>
                    <button name="action_ironing" string="Mulai Setrika" type="object" class="oe_highlight"
                            invisible="state not in ('received', 'drying')"/>
                    <button name="action_ready" string="Siap Diambil / Dikirim" type="object" class="oe_highlight"
                            invisible="state not in ('drying', 'ironing')"/>
                    <button name="action_out_for_delivery" string="Kirim ke Pelanggan" type="object" class="oe_highlight"
                            invisible="state != 'ready' or delivery_type != 'delivery'"/>
                    <button name="action_complete" string="Selesai" type="object" class="oe_highlight"
                            invisible="(delivery_type == 'delivery' and state != 'out_for_delivery') or (delivery_type == 'pickup' and state != 'ready')"/>
                    <button name="action_cancel" string="Batalkan" type="object"
                            invisible="state in ('completed', 'cancelled')"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="received,washing,drying,ironing,ready,completed"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="partner_id"/>
                            <field name="order_date"/>
                            <field name="service_speed"/>
                            <field name="service_speed_fee" invisible="service_speed != 'same_day'"/>
                            <field name="delivery_type"/>
                            <field name="user_id"/>
                        </group>
                        <group>
                            <field name="total_amount"/>
                            <field name="weight"/>
                            <field name="currency_id" invisible="1"/>
                            <field name="invoice_id"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Detail Layanan">
                            <field name="line_ids">
                                <list editable="bottom">
                                    <field name="product_template_id"/>
                                    <field name="item_details"/>
                                    <field name="pricing_type"/>
                                    <field name="length" invisible="pricing_type != 'area'"/>
                                    <field name="width" invisible="pricing_type != 'area'"/>
                                    <field name="area" invisible="pricing_type != 'area'"/>
                                    <field name="quantity"/>
                                    <field name="weight" invisible="pricing_type != 'weight'"/>
                                    <field name="uom_id"/>
                                    <field name="price_unit"/>
                                    <field name="subtotal"/>
                                    <field name="currency_id" column_invisible="True"/>
                                </list>
                            </field>
                        </page>
                        <page string="Detail Barang &amp; Catatan">
                            <group>
                                <field name="item_details"/>
                                <field name="notes"/>
                            </group>
                        </page>
                        <page string="Legacy Single-Service Info" invisible="not service_type and not price_per_kg">
                            <group>
                                <field name="service_type"/>
                                <field name="price_per_kg"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_laundry_order" model="ir.actions.act_window">
        <field name="name">Pesanan Laundry</field>
        <field name="res_model">laundry.order</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_laundry_root"
              name="LaundryFlow"
              sequence="10"/>

    <menuitem id="menu_laundry_orders"
              name="Pesanan Laundry"
              parent="menu_laundry_root"
              action="action_laundry_order"
              sequence="10"/>
</odoo>
