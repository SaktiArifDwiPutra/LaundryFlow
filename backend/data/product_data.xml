        <!-- UoM: Set -->
        <record id="uom_set" model="uom.uom">
            <field name="name">set</field>
            <field name="relative_uom_id" ref="uom.product_uom_unit"/>
            <field name="relative_factor">1.0</field>
            <field name="factor">1.0</field>
            <field name="active" eval="True"/>
