    {
      "name": "4. Inventory",
      "description": "Pengujian inventory bahan laundry: SKU, harga beli, harga jual, stok aktual, UoM, produk stok nol, batch & kedaluwarsa, dan hak akses.",
      "item": [
        {
          "name": "4.1 Daftar Bahan Laundry (Stok Aktual & Harga Beli)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200\", function () {\n    pm.response.to.have.status(200);\n});",
                  "pm.test(\"Response contains data array\", function () {\n    var jsonData = pm.response.json();\n    pm.expect(jsonData.data).to.be.an('array');\n});",
                  "pm.test(\"Materials have SKU, cost, price, stock, uom, and zero stock support\", function () {\n    var jsonData = pm.response.json();\n    jsonData.data.forEach(function(mat) {\n        pm.expect(mat).to.have.property('id');\n        pm.expect(mat).to.have.property('sku');\n        pm.expect(mat).to.have.property('name');\n        pm.expect(mat).to.have.property('purchase_price');\n        pm.expect(mat).to.have.property('sale_price');\n        pm.expect(mat).to.have.property('quantity_on_hand');\n        pm.expect(mat).to.have.property('uom');\n        pm.expect(mat).to.have.property('batches');\n        pm.expect(mat.quantity_on_hand).to.be.at.least(0);\n    });\n});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/laundry/inventory",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
