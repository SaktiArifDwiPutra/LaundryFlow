      "name": "1. Authentication",
      "description": "Pengujian autentikasi, login valid, login invalid, dan manajemen session_id.",
      "item": [
        {
          "name": "1.1 Login Valid (Simpan authToken)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200\", function () {\n    pm.response.to.have.status(200);\n});",
                  "pm.test(\"Response has success true and session_id\", function () {\n    var jsonData = pm.response.json();\n    pm.expect(jsonData.success).to.be.true;\n    pm.expect(jsonData.data).to.have.property('session_id');\n    pm.environment.set('authToken', jsonData.data.session_id);\n});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"login\": \"{{username}}\",\n  \"password\": \"{{password}}\",\n  \"db\": \"{{dbName}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/laundry/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "laundry",
                "auth",
                "login"
              ]
            }
          }
        },
        {
