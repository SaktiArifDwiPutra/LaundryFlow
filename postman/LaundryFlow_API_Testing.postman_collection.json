              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200\", function () {\n    pm.response.to.have.status(200);\n});",
                  "pm.test(\"Batch items have valid lot_id, batch_number, quantity, status\", function () {\n    var jsonData = pm.response.json();\n    jsonData.data.forEach(function(mat) {\n        mat.batches.forEach(function(b) {\n            pm.expect(b).to.have.property('lot_id');\n            pm.expect(b).to.have.property('batch_number');\n            pm.expect(b).to.have.property('quantity');\n            pm.expect(b).to.have.property('expiration_status');\n            pm.expect(['safe', 'expiring_soon', 'expired', 'unknown']).to.include(b.expiration_status);\n        });\n    });\n});"
